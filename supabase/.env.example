# Biến cho Supabase CLI (config.toml đọc qua env(...)) và secrets của Edge Functions.
# Copy thành supabase/.env — file này đã bị .gitignore chặn.

# Edge Functions → đẩy lên cloud: supabase secrets set --env-file supabase/.env
GEMINI_API_KEY=your_gemini_api_key
# Để trống sẽ dùng gemini-flash-latest
GEMINI_MODEL=

# Google provider (config.toml [auth.external.google])
# Web client ID đứng đầu, sau đó iOS client ID, ngăn cách bằng dấu phẩy
GOOGLE_CLIENT_IDS=000000000000-web.apps.googleusercontent.com,000000000000-ios.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_web_client_secret
