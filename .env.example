# =============================================================================
# Túi Khôn Mobile — Environment Variables (SAMPLE)
# =============================================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit the real .env file to version control.
#
# Usage with Flutter:
#   flutter run --dart-define-from-file=.env
#   flutter build ios --dart-define-from-file=.env
# =============================================================================

# -----------------------------------------------------------------------------
# SUPABASE (backend + database)
# Supabase Dashboard → Project Settings → API.
# Only the anon/publishable key belongs here — NEVER the service_role key.
# -----------------------------------------------------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_or_publishable_key

# -----------------------------------------------------------------------------
# GOOGLE SIGN-IN (google_sign_in → supabase.auth.signInWithIdToken)
# Web client ID is passed as serverClientId; iOS client ID for GoogleSignIn on iOS.
# -----------------------------------------------------------------------------
GOOGLE_WEB_CLIENT_ID=000000000000-xxxxxxxx.apps.googleusercontent.com
GOOGLE_IOS_CLIENT_ID=000000000000-yyyyyyyy.apps.googleusercontent.com

# GEMINI_API_KEY is intentionally NOT here: it lives in Supabase secrets and the
# app reaches Gemini only through Edge Functions (ai-quick-record, ai-advisor).
