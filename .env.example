# =============================================================================
# Túi Khôn Mobile — Environment Variables (SAMPLE)
# =============================================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit the real .env file to version control.
#
# Usage with Flutter:
#   flutter run --dart-define-from-file=.env
#   flutter build ios --dart-define-from-file=.env
# =============================================================================

# -----------------------------------------------------------------------------
# APP ENVIRONMENT
# Options: development | staging | production | mock
# -----------------------------------------------------------------------------
APP_ENV=development

# -----------------------------------------------------------------------------
# API BASE URLs
# Override the defaults in ApiConfig if needed
# -----------------------------------------------------------------------------
API_BASE_URL_DEV=https://api-dev.tuikhon.vn/v1
API_BASE_URL_STAGING=https://api-staging.tuikhon.vn/v1
API_BASE_URL_PRODUCTION=https://api.tuikhon.vn/v1

# -----------------------------------------------------------------------------
# GEMINI AI
# Get your key at: https://aistudio.google.com/app/apikey
# -----------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here

# -----------------------------------------------------------------------------
# FIREBASE
# Download GoogleService-Info.plist from Firebase Console (iOS)
# These values mirror the plist for use in --dart-define builds
# -----------------------------------------------------------------------------
FIREBASE_IOS_API_KEY=your_firebase_ios_api_key_here
FIREBASE_IOS_APP_ID=1:000000000000:ios:xxxxxxxxxxxxxxxxxxxxxxxx
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_MESSAGING_SENDER_ID=000000000000
FIREBASE_STORAGE_BUCKET=your_project.appspot.com

# -----------------------------------------------------------------------------
# VIETQR / BANKING
# Register at: https://vietqr.io
# -----------------------------------------------------------------------------
VIETQR_CLIENT_ID=your_vietqr_client_id_here
VIETQR_API_KEY=your_vietqr_api_key_here

# -----------------------------------------------------------------------------
# APP SETTINGS
# -----------------------------------------------------------------------------
# Maximum AI requests per day (free tier)
AI_DAILY_LIMIT_FREE=50

# Enable/disable mock mode (true | false)
MOCK_MODE=false
